<view class="wrap">
  <view wx:for="{{orders}}" wx:key="id" class="order card">
    <view>{{item.name}} 订单号:{{item.id}} 状态:{{item.status}}</view>
    <view>快递服务 {{item.ship}} 单号:{{item.shipNo}} 订单类型:{{item.kind}}</view>
    <view>地址:{{item.address}}</view>
  </view>
  <view class="bottom-pad"></view>
</view>
